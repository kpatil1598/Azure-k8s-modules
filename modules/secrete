# Kubernetes Secret (generic type)
resource "kubernetes_secret" "storage_key" {
  metadata {
    name      = "storage-account-secret"
    namespace = "default" # or your specific namespace
  }
  data = {
    azurestorageaccountname = azurerm_storage_account.example.name
    azurestorageaccountkey  = azurerm_storage_account.example.primary_access_key
  }
  type = "Opaque"
}


az feature register --name EnableIPv6DualStack --namespace Microsoft.ContainerService
az feature register --name AKS-KubeletDualStack --namespace Microsoft.ContainerService
az feature register --name EnableIPv6OnAKS --namespace Microsoft.Network

az provider register --namespace Microsoft.ContainerService
az provider register --namespace Microsoft.Network

