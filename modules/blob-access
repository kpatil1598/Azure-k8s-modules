resource "azurerm_user_assigned_identity" "blob_reader" {
  name                = "blob-storage-uami"
  location            = var.location
  resource_group_name = var.resource_group
}

resource "azurerm_role_assignment" "blob_access" {
  principal_id         = azurerm_user_assigned_identity.blob_reader.principal_id
  scope                = azurerm_storage_account.blob.id
  role_definition_name = "Storage Blob Data Reader"
}

resource "azurerm_federated_identity_credential" "fid" {
  name                = "blob-federation"
  resource_group_name = var.resource_group
  parent_id           = azurerm_user_assigned_identity.blob_reader.id
  audience            = ["api://AzureADTokenExchange"]
  issuer              = azurerm_kubernetes_cluster.aks.oidc_issuer_url
  subject             = "system:serviceaccount:default:blob-reader-sa"
}

##create kubernetes service account
apiVersion: v1
kind: ServiceAccount
metadata:
  name: blob-reader-sa
  namespace: default
  annotations:
    azure.workload.identity/client-id: <UAMI_CLIENT_ID>

apiVersion: v1
kind: Pod
metadata:
  name: blob-access
spec:
  serviceAccountName: blob-reader-sa
  containers:
  - name: blob
    image: mcr.microsoft.com/azure-cli
    command: [ "sleep", "3600" ]

